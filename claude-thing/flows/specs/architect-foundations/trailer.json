  "steps": [
    { "caption": "Your code calls query() once; the SDK runs the loop and returns a ResultMessage.", "focus": ["code"], "send": { "from": "code", "to": "sdk", "icon": "play", "label": "query(prompt, opts)" }, "reply": { "from": "sdk", "to": "code", "icon": "flag", "label": "ResultMessage" }, "callout": { "at": "sdk", "text": "reason → tool → result → repeat" }, "state": { "at": "sdk", "text": "the agent loop" } },
    { "caption": "ClaudeAgentOptions allows Read, Grep; denies Bash. Claude tries it; deny wins.", "focus": ["claude"], "send": { "from": "claude", "to": "sdk", "icon": "wrench", "label": "tool_use: Bash" }, "reply": { "from": "sdk", "to": "claude", "icon": "ban", "label": "ERROR: disallowed" }, "callout": { "at": "code", "text": "allow Read, Grep · deny Bash" }, "state": { "at": "sdk", "text": "+ options" } },
    { "caption": "You give Claude hands: Read, Edit, Bash, your @tool. Failures come back as data.", "focus": ["tools"], "send": { "from": "sdk", "to": "tools", "icon": "wrench", "label": "@tool check_stock" }, "reply": { "from": "tools", "to": "sdk", "icon": "triangle-alert", "label": "is_error result" }, "callout": { "at": "claude", "text": "Retry, or change approach" }, "state": { "at": "sdk", "text": "+ tools" } },
    { "caption": "MCP servers plug in: fs over stdio, crm over http. The SDK is the MCP client.", "focus": ["tools"], "send": { "from": "sdk", "to": "tools", "icon": "plug", "label": "tools/list · stdio" }, "reply": { "from": "tools", "to": "sdk", "icon": "wrench", "label": "mcp__fs__read_file" }, "callout": { "at": "sdk", "text": "one protocol, no per-tool glue" }, "state": { "at": "sdk", "text": "+ MCP" } },
    { "caption": "The Agent tool hands work to a researcher; the memo returns, not the notebook.", "focus": ["claude"], "send": { "from": "claude", "to": "sdk", "icon": "bot", "label": "tool_use: Agent" }, "reply": { "from": "sdk", "to": "claude", "icon": "file-check", "label": "memo: 3 dates" }, "callout": { "at": "sdk", "text": "fresh context · no parent history" }, "state": { "at": "sdk", "text": "+ subagents" } },
    { "caption": "Claude reaches for rm -rf; a PreToolUse hook denies it before it ever runs.", "focus": ["sdk"], "send": { "from": "claude", "to": "sdk", "icon": "terminal", "label": "Bash: rm -rf build/" }, "reply": { "from": "sdk", "to": "claude", "icon": "circle-x", "label": "Blocked by hook" }, "callout": { "at": "sdk", "text": "hooks enforce; prompts only suggest" }, "badge": { "at": "sdk", "kind": "cross", "text": "denied" }, "state": { "at": "sdk", "text": "+ hooks" } },
    { "caption": "You give the agent a memory: resume=session_id continues, fork_session branches.", "focus": ["code"], "send": { "from": "code", "to": "sdk", "icon": "history", "label": "resume=session_id" }, "reply": { "from": "sdk", "to": "code", "icon": "git-branch", "label": "fork: new id" }, "callout": { "at": "sdk", "text": "session = storage · context = memory" }, "state": { "at": "sdk", "text": "+ sessions" } },
    { "caption": "A human gates restarts in can_use_tool; six enterprise patterns take shape.", "focus": ["code"], "send": { "from": "sdk", "to": "code", "icon": "shield", "label": "approval requested" }, "reply": { "from": "code", "to": "sdk", "icon": "badge-check", "label": "human says yes" }, "callout": { "at": "code", "text": "governed and ready" }, "badge": { "at": "code", "kind": "check", "text": "ready" }, "state": { "at": "sdk", "text": "+ security · governed" } }
