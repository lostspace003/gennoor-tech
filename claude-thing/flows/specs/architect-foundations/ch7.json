    { "caption": "Your code registers two hooks: PreToolUse on Bash, PostToolUse with no matcher.", "focus": ["gate"], "callout": { "at": "gate", "text": "HookMatcher(matcher=\"Bash\")" }, "state": { "at": "gate", "text": "2 hooks registered" } },
    { "caption": "Asked to clean the build folder, Claude reaches for rm -rf and emits a tool_use.", "focus": ["claude"], "send": { "from": "claude", "to": "gate", "icon": "wrench", "label": "Bash: rm -rf build/" }, "callout": { "at": "claude", "text": "\"Clean the build folder\"" } },
