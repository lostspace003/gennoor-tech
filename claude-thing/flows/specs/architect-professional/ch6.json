    { "caption": "Under the same ID, retrieval queries the vector DB for A-29471: 0 results.", "send": { "from": "agent", "to": "retrieval", "icon": "search", "label": "policy A-29471?" }, "reply": { "from": "retrieval", "to": "agent", "icon": "circle-x", "label": "0 results" }, "state": { "at": "retrieval", "text": "span 2 · 0 results" } },
