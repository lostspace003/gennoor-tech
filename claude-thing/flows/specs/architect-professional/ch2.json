  "steps": [
    { "caption": "A billing clerk asks which procedure codes were billed for patient P-12345.", "focus": ["clerk"], "send": { "from": "clerk", "to": "retrieval", "icon": "message-square", "label": "codes for P-12345?" } },
    { "caption": "Wrong way: a shared token pulls every match, diagnoses too, into the prompt.", "focus": ["claude"], "send": { "from": "retrieval", "to": "index", "icon": "key-round", "label": "shared svc token" }, "reply": { "from": "index", "to": "claude", "icon": "file-text", "label": "billing + diagnosis" }, "callout": { "at": "claude", "text": "system prompt: hide the clinical bits" }, "badge": { "at": "claude", "kind": "warn", "text": "too late" } },
    { "caption": "Right way: your design passes the clerk's own identity, never a shared token.", "focus": ["retrieval"], "send": { "from": "clerk", "to": "retrieval", "icon": "key-round", "label": "billing_clerk_47" }, "state": { "at": "retrieval", "text": "billing, demographics" } },
    { "caption": "Retrieval applies the ACL filter in the vector DB query: billing, demographics.", "send": { "from": "retrieval", "to": "index", "icon": "search", "label": "ACL-filtered query" }, "reply": { "from": "index", "to": "retrieval", "icon": "file-text", "label": "billing passages" }, "callout": { "at": "retrieval", "text": "WHERE acl.allowed_roles ∩ user.roles" }, "state": { "at": "index", "text": "diagnosis never leaves" } },
