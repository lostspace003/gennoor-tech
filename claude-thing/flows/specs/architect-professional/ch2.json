    { "caption": "Your answer to compliance: restricted documents never leave the retrieval layer.", "focus": ["retrieval"], "callout": { "at": "retrieval", "text": "deterministic, not a prompt promise" }, "state": { "at": "retrieval", "text": "audit: clerk_47 → docs" } }
