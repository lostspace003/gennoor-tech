# Database - Local PostgreSQL
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/gennoor_leads"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/gennoor_leads?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NO_SSL="postgresql://postgres:postgres@localhost:5432/gennoor_leads"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/gennoor_leads"
POSTGRES_USER="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="postgres"
POSTGRES_DATABASE="gennoor_leads"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-local-development-secret-change-this-in-production"

# Microsoft Entra ID (Optional for local - can use email/password)
MICROSOFT_ENTRA_CLIENT_ID=""
MICROSOFT_ENTRA_CLIENT_SECRET=""
MICROSOFT_ENTRA_TENANT_ID=""

# OpenAI (Required - Get from https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# Bing Search (Optional for local testing)
BING_API_KEY=""

# Azure Storage (Optional for local - will use local file system)
AZURE_STORAGE_CONNECTION_STRING=""

# Email Service (Optional for local)
EMAIL_SERVER=""
EMAIL_FROM="admin@gennoor.com"
ACS_CONNECTION_STRING=""

# Service URLs (Local)
EMBEDDING_SERVICE_URL="http://localhost:8001"
RAG_API_URL="http://localhost:8002"
INDEXER_SERVICE_URL="http://localhost:8003"

# Development Mode
NODE_ENV="development"
USE_LOCAL_LLM="false"

# Redis (Local)
REDIS_URL="redis://localhost:6379"